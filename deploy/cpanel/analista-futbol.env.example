# Copy this file to analista-futbol.env on the server and replace secrets.

HOST_PORT=8501

APP_BASE_URL=https://futbol.astrogatolabs.com.mx
APP_SECRET_KEY=replace-with-openssl-rand-hex-32
STREAMLIT_SERVER_COOKIE_SECRET=replace-with-openssl-rand-hex-32

SEED_ADMIN_EMAIL_1=admin@astrogatolabs.com.mx
SEED_ADMIN_EMAIL_2=
SEED_ADMIN_PASSWORD=replace-with-a-long-temporary-password
INVITATION_TTL_HOURS=72

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NARRADOR_USER_EMAIL=demo@astrogatolabs.com.mx

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Astrogato Labs
SMTP_USE_TLS=true
SMTP_USE_SSL=false
